# سرچشمه — Environment variables template
# این فایل رو کپی کن به .env و مقادیر رو پر کن

# Prisma database — نیازی به تغییر نیست
DATABASE_URL=file:./db/custom.db

# Google Drive sync — اختیاری
# برای فعال‌سازی همگام‌سازی:
# 1. به https://console.cloud.google.com برو
# 2. یک پروژه بساز → Google Drive API رو Enable کن
# 3. OAuth consent screen رو تنظیم کن
# 4. Credentials → Create OAuth client ID → Web application
# 5. در Authorized JavaScript origins، آدرس‌های اپ خودت رو add کن
#    (مثلاً http://localhost:3000 و آدرس production)
# 6. Client ID ساخته‌شده رو اینجا بذار
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
